{
  "rewrites": [
    {
      "source": "/.well-known/apple-app-site-association",
      "has": [
        {
          "type": "host",
          "value": "share-dev.prepeat.app"
        }
      ],
      "destination": "/aasa/dev.json"
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/aasa/production.json"
    },
    {
      "source": "/og/:token",
      "destination": "/api/og/:token"
    },
    {
      "source": "/r/:token",
      "destination": "/api/r/:token"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://prepeat.app",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
